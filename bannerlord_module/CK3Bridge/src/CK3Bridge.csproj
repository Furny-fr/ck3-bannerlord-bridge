<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The CK3Bridge Bannerlord module. Build: dotnet build -c Release [-p:BannerlordDir="<Bannerlord install folder>"]
    (or set BANNERLORD_DIR; without either the Steam libraries are searched, see BannerlordDir.props). The output goes to
    ../bin/Win64_Shipping_Client, next to SubModule.xml and GUI/, which together are the module folder.
  -->
  <Import Project="BannerlordDir.props" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CK3Bridge</AssemblyName>
    <RootNamespace>CK3Bridge</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The CK3 x Bannerlord release; SubModule.xml carries the same version as v0.9.0 (Bannerlord's version format has no suffix). -->
    <VersionPrefix>0.9.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
    <Authors>graff0n</Authors>
    <Company>graff0n</Company>
    <Product>CK3 x Bannerlord</Product>
    <Copyright>Copyright (c) 2026 graff0n</Copyright>
    <!-- No build-machine folders in the DLL (its debug directory names the PDB as /_/... instead of the checkout path). -->
    <Deterministic>true</Deterministic>
    <PathMap Condition="'$(PathMap)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The protocol v2 DTOs shared with the bridge (docs/PROTOCOL.md §3). -->
    <Compile Include="..\..\..\shared\Protocol.cs" Link="Shared\Protocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.*.dll" Exclude="$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.Native.dll" Private="false" />
    <Reference Include="$(BannerlordDir)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.View.dll" Private="false" />
    <Reference Include="$(BannerlordDir)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.GauntletUI.dll" Private="false" />
    <Reference Include="$(BannerlordDir)\Modules\CustomBattle\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.CustomBattle.dll" Private="false" />
    <Reference Include="$(BannerlordDir)\bin\Win64_Shipping_Client\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
</Project>
